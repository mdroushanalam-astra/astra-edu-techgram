import { readFileSync, readdirSync, writeFileSync } from "node:fs";
import { join } from "node:path";
import { pathToFileURL } from "node:url";
import type { Atom } from "../kernel/src/atoms.js";

const sections = { Explanation: "explanation", Example: "example", "Common mistake": "common_mistake", "Hint 1": "hint_l1", "Hint 2": "hint_l2", "Hint 3": "hint_l3" } as const;
export function compileLesson(text: string): { atoms: Atom[]; metadata: Record<string, unknown> } {
  const match = text.replaceAll("\r\n", "\n").match(/^---\n([\s\S]*?)\n---\n([\s\S]+)$/);
  if (!match) throw new Error("Expected JSON front matter between --- markers");
  const meta = JSON.parse(match[1]!);
  for (const key of ["id", "title", "source", "reviewer", "status", "version", "language", "curriculum"]) if (!meta[key]) throw new Error(`Missing ${key}`);
  if (!/^[a-z][a-z0-9_]+$/.test(meta.id) || !Number.isInteger(meta.version) || meta.version < 1) throw new Error("Invalid stable ID/version");
  if (!["seed", "reviewed"].includes(meta.status) || meta.language !== "en") throw new Error("Unsupported publication status/language");
  if (meta.status === "reviewed" && (!meta.reviewed_at || !meta.license)) throw new Error("Reviewed content requires review date and use rights");
  if (new URL(meta.source).protocol !== "https:") throw new Error("Source must use HTTPS");
  const bodies = new Map<string, string>();
  for (const part of match[2]!.split(/^## /m).slice(1)) {
    const newline = part.indexOf("\n");
    const heading = part.slice(0, newline).trim();
    if (bodies.has(heading)) throw new Error(`Duplicate section ${heading}`);
    bodies.set(heading, part.slice(newline + 1).trim());
  }
  const atoms: Atom[] = Object.entries(sections).map(([heading, kind]) => {
    const body = bodies.get(heading);
    if (!body || body.length < 15) throw new Error(`Missing/incomplete ${heading}`);
    return { id: `geo_${meta.id}_${kind}`, conceptId: meta.id, kind, body, lang: "en", source: meta.source, verifiedBy: `${meta.reviewer} · ${meta.status === "seed" ? "expert review pending" : "reviewed"}`, version: meta.version, riskLevel: "fact" };
  });
  return { atoms, metadata: meta };
}
export function compilePack(directory: string) {
  const lessons = readdirSync(directory).filter(f => f.endsWith(".md")).sort().map(f => compileLesson(readFileSync(join(directory, f), "utf8")));
  const ids = lessons.map(l => l.metadata.id);
  if (new Set(ids).size !== ids.length) throw new Error("Duplicate concept IDs");
  for (const lesson of lessons) for (const id of (lesson.metadata.prerequisites ?? []) as string[]) if (!ids.includes(id)) throw new Error(`Unknown prerequisite ${id}`);
  const visit = (id: unknown, path: unknown[]) => {
    if (path.includes(id)) throw new Error("Prerequisite cycle");
    const lesson = lessons.find(l => l.metadata.id === id)!;
    for (const next of (lesson.metadata.prerequisites ?? []) as string[]) visit(next, [...path, id]);
  };
  ids.forEach(id => visit(id, []));
  return { version: "geo-lessons-1", atoms: lessons.flatMap(l => l.atoms), lessons: lessons.map(l => l.metadata) };
}
if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {
  const pack = compilePack("content/packs/geography");
  writeFileSync("content/geography.generated.ts", `// Generated by npm run content:compile. Edit the Markdown sources.\nexport const geographyPack = ${JSON.stringify(pack, null, 2)} as const;\n`);
  console.log(`Compiled ${pack.lessons.length} seed lessons / ${pack.atoms.length} atoms; expert review status preserved.`);
}
